{
  "name": "cios.iai.one",
  "version": "1.1.0",
  "description": "Customer Intelligence OS backend foundation API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "sync:site-version": "node scripts/sync-site-version.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "tsx src/scripts/run-migrations.ts",
    "smoke:workers": "bash scripts/smoke-workers-e2e.sh",
    "smoke:workers:strict": "bash scripts/smoke-workers-e2e.sh --strict",
    "predeploy:pages": "npm run sync:site-version",
    "deploy:pages": "wrangler pages deploy site --project-name=cios-iai-one"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tranhatam-collab/cios.iai.one.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/tranhatam-collab/cios.iai.one/issues"
  },
  "homepage": "https://github.com/tranhatam-collab/cios.iai.one#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.1"
  }
}
