NODE_ENV=development
PORT=3000
APP_NAME=customer-intelligence-os-api
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/customer_intelligence
JWT_SECRET=replace_me
SESSION_SECRET=replace_me
LOG_LEVEL=debug
FLOW_WEBHOOK_SECRET=replace_me_flow_webhook_secret

# AI Agent integration (optional — fallback rule engine used if unset)
AIAGENT_API_URL=https://api.aiagent.iai.one
AIAGENT_API_KEY=replace_me_aiagent_api_key

# Frontend origin (redirect URLs / payment flows)
FRONTEND_URL=https://cios.iai.one

# Cloudflare — account that owns cios.iai.one Pages + Workers (f3f9…), not hard-coded
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_HERE
